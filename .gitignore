# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is the exception — a template with no secrets, meant to be committed)
.env*
!.env.example

# vercel
.vercel

# user-uploaded files (Payload's Media collection, local disk storage — see
# src/collections/Media.ts's header comment on swapping to cloud storage
# before a real deploy)
/media/

# typescript
*.tsbuildinfo
next-env.d.ts

# internal build-process docs (not part of the shipped app)
CLAUDE.md
AGENTS.md
/phases/
/.claude/
