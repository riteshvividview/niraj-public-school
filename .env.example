# Copy this to .env and fill in real values. See CLAUDE.md / .claude/DECISIONS.md
# for why Payload talks to Postgres directly (DATABASE_URI) rather than through
# the Supabase client SDK.

# Postgres connection string (Supabase: Project Settings -> Database -> Connection
# string). Any special characters in the password must be percent-encoded (e.g. `@`
# -> `%40`) or the connection string won't parse.
# For the deployed app use the POOLER string (Project Settings -> Database -> Connection pooling,
# transaction mode, port 6543, host aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>):
# the direct db.<ref>.supabase.co:5432 address is IPv6-only and struggles under serverless load.
# Keep the DIRECT string only for running migrations locally (SUPABASE_DB_PASSWORD below).
DATABASE_URI=

# Secret that lets the daily cleanup job (vercel.json cron -> /api/cron/cleanup) run. Any long random string;
# Vercel sends it automatically as a Bearer token when it is set as a project env var.
CRON_SECRET=

# Long random string Payload uses to sign JWTs/cookies. e.g. `openssl rand -base64 32`
PAYLOAD_SECRET=

# Supabase project keys — not read by any code yet, placeholders for future
# direct-Supabase-client use (e.g. file storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase CLI (see supabase/README.md) --------------------------------
# Personal access token: supabase.com -> Account -> Access Tokens. Lets
# `npm run supabase:*` scripts run non-interactively.
SUPABASE_ACCESS_TOKEN=

# The project's DB password, NOT percent-encoded (unlike the copy inside
# DATABASE_URI above) — the Supabase CLI wants it raw.
SUPABASE_DB_PASSWORD=

# Optional override for the base URL used to build links in console invite
# emails (src/lib/app-url.ts) — normally derived automatically from the
# request's own Host header (localhost:3000 in dev, your real domain once
# deployed), so this is only needed to force a specific domain (e.g. a
# canonical domain instead of a preview deployment URL). Leave blank
# otherwise.
NEXT_PUBLIC_APP_URL=

# --- Brevo (transactional email) -------------------------------------------
# app.brevo.com -> Settings -> SMTP & API -> API Keys. Used for OTP emails
# and order ready/collected notifications — see src/lib/email/brevo.ts.
# Free tier: 300 emails/day.
BREVO_API_KEY=
# Must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- Payments (Razorpay) ----------------------------------------------------
# Leave all of these blank and checkout runs in TEST MODE (no real money moves).
# To go live fill the three values below from the Razorpay Dashboard and restart -
# nothing else changes. Administration -> Payments in the console shows what is
# still missing and the webhook address to give Razorpay.
#   Start with Razorpay's Test Mode keys (rzp_test_...), then swap in the live keys.
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Account & Settings -> API Keys.
#   Webhook (Account & Settings -> Webhooks): URL = <your site>/api/payments/webhook,
#   a secret of your choice (= RAZORPAY_WEBHOOK_SECRET), events payment.captured,
#   payment.failed, order.paid. The webhook is what confirms a payment when the
#   parent's screen closed mid-payment (power cut, closed tab).
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
