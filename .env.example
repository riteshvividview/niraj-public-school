# Copy this to .env and fill in real values. See CLAUDE.md / .claude/DECISIONS.md
# for why Payload talks to Postgres directly (DATABASE_URI) rather than through
# the Supabase client SDK.

# Postgres connection string (Supabase: Project Settings -> Database -> Connection
# string). Any special characters in the password must be percent-encoded (e.g. `@`
# -> `%40`) or the connection string won't parse.
DATABASE_URI=

# Long random string Payload uses to sign JWTs/cookies. e.g. `openssl rand -base64 32`
PAYLOAD_SECRET=

# Supabase project keys — not read by any code yet, placeholders for future
# direct-Supabase-client use (e.g. file storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase CLI (see supabase/README.md) --------------------------------
# Personal access token: supabase.com -> Account -> Access Tokens. Lets
# `npm run supabase:*` scripts run non-interactively.
SUPABASE_ACCESS_TOKEN=

# The project's DB password, NOT percent-encoded (unlike the copy inside
# DATABASE_URI above) — the Supabase CLI wants it raw.
SUPABASE_DB_PASSWORD=

# Optional override for the base URL used to build links in console invite
# emails (src/lib/app-url.ts) — normally derived automatically from the
# request's own Host header (localhost:3000 in dev, your real domain once
# deployed), so this is only needed to force a specific domain (e.g. a
# canonical domain instead of a preview deployment URL). Leave blank
# otherwise.
NEXT_PUBLIC_APP_URL=

# --- Brevo (transactional email) -------------------------------------------
# app.brevo.com -> Settings -> SMTP & API -> API Keys. Used for OTP emails
# and order ready/collected notifications — see src/lib/email/brevo.ts.
# Free tier: 300 emails/day.
BREVO_API_KEY=
# Must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- Payments (HDFC Bank SmartGateway) --------------------------------------
# Leave all of these blank and checkout runs in TEST MODE (no real money moves).
# To go live, fill the five values below from the HDFC SmartGateway dashboard and
# restart — nothing else changes. Administration -> Payments in the console shows
# what is still missing and the webhook address to give the bank.
#   Webhook (dashboard -> Settings -> Webhooks): URL = <your site>/api/payments/webhook,
#   Basic authentication with the username/password below, order events enabled.
#   The webhook is what confirms a payment when the parent's screen closed
#   mid-payment (power cut, closed tab).
PAYMENT_PROVIDER=
HDFC_API_KEY=
HDFC_MERCHANT_ID=
HDFC_PAYMENT_PAGE_CLIENT_ID=
HDFC_WEBHOOK_USERNAME=
HDFC_WEBHOOK_PASSWORD=
# Optional. Blank = production (https://smartgateway.hdfcbank.com).
# For the bank's test environment use https://smartgateway.hdfcuat.bank.in
HDFC_BASE_URL=
